{
  "name": "guard-fraud-prevention",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names web,api --prefix-colors cyan,magenta \"next dev\" \"backend/.venv/bin/uvicorn backend.app.main:app --reload --host 127.0.0.1 --port 8000\"",
    "build": "NEXT_BUILD_DIR=.next-build next build",
    "start": "NEXT_BUILD_DIR=.next-build next start",
    "lint": "next lint",
    "db:migrate": "python3 backend/scripts/migrate.py",
    "test:backend": "backend/.venv/bin/python -m unittest discover -s backend/tests -v"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "lucide-react": "^0.468.0",
    "next": "^15.5.27",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.13.3",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "source-map-js": "^1.2.2"
  }
}
