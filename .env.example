# The current FastAPI-owned auth path does not require Supabase browser keys.
# Leave these blank unless a future server-only storage feature uses them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=5
ANALYSIS_PERSISTENCE_ENABLED=true
ANALYSIS_DATABASE_LOOKUP_ENABLED=true
STORE_ANALYSIS_CONTENT=false

# Local FastAPI/PostgreSQL backend. Copy these entries to backend/.env.
# For production, use the managed Supabase Postgres session-pooler connection string.
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/guard
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# Demo accounts are useful locally. Set this to false (or omit it) in production.
NEXT_PUBLIC_ENABLE_DEMO_AUTH=true
