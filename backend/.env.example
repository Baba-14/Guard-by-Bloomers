DATABASE_URL=postgresql+psycopg://postgres:your-password@localhost:5432/guard
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=5
ANALYSIS_PERSISTENCE_ENABLED=true
ANALYSIS_DATABASE_LOOKUP_ENABLED=true
# Raw submissions can contain sensitive information. Disabled by default; hashes and
# analysis results are still stored for audit and aggregate review.
STORE_ANALYSIS_CONTENT=false
