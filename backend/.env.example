# Local PostgreSQL or a managed Supabase Postgres session-pooler URL.
# Standard postgresql:// URLs are accepted and normalized by the app.
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/guard
JWT_SECRET=replace-with-a-long-random-secret
# Separate server-only pepper used to hash partner API keys at rest.
API_KEY_PEPPER=replace-with-a-different-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=5
ANALYSIS_PERSISTENCE_ENABLED=true
ANALYSIS_DATABASE_LOOKUP_ENABLED=true
# Raw submissions can contain sensitive information. Disabled by default; hashes and
# analysis results are still stored for audit and aggregate review.
STORE_ANALYSIS_CONTENT=false
TELEGRAM_BOT_TOKEN=
# Generate a random value accepted by Telegram: A-Z, a-z, 0-9, underscore, hyphen.
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated negative group/supergroup IDs, for example: -1001234567890
TELEGRAM_ALLOWED_GROUP_IDS=
TELEGRAM_TIMEOUT_SECONDS=5
